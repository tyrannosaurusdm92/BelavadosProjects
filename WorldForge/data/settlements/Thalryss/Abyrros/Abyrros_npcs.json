  "npcs": [
    {
      "id": "captain-averra-salt",
      "name": "Captain Averra Salt",
      "sourceType": "immersive_npc_roster",
      "sourceFile": "NPC Rosters.docx",
      "province": "Thalryss",
      "provinceKey": "thalryss",
      "settlement": "Abyrros",
      "settlementKey": "thalryss:Abyrros",
      "description": "Captain Averra Salt is a trans Satyr harbor captain with a performer’s command of a crowd and a survivor’s suspicion of every calm tide. In Abyrros, she holds together docks, evacuation routes, fishing crews, militia watches, and The Choral Synod patrols while refusing to let zealots, monsters, or merchants decide whose lives are worth saving. She is warm in public, exhausted in private, and ruthless when a community’s survival demands that someone give the order no one else wants to own.",
      "settlementAndAncestryTexture": "Abyrros is a Town in Thalryss, under Protectorate, with high danger, Ocean Surface floating settlement terrain. Local records favor Neutral, Lawful, Cooperative, Honorable civic habits; common communities include Human, Halfling — Lightfoot Halfling, Elf — Sea Elf, Tortle, Genasi — Water Genasi. Satyr reads through the Satyr entry of the race compendium, within Fey and Trickster Folk, marked by Thalunesh. Satyrs are goat-legged fey known for revelry, music, and indulgence in natural pleasures. They often serve as companions of wilderness spirits and chaotic celebration. Table cues: Fey, Ram, Magic Resistance, Mirthful Leaps; starting tendency Altruistic - Chaotic - Cooperative - Neutral.",
      "rumors": [
        "Captain Averra Salt knows why an ichor ledger changed hands last Marduday.",
        "Captain Averra Salt has a contact in Streccea who will deny everything."
      ],
      "plotHooks": [
