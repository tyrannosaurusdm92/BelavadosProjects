  "npcs": [
    {
      "id": "agent-xevran-gostamin",
      "name": "Agent Xevran Gostamin",
      "sourceType": "immersive_npc_roster",
      "sourceFile": "NPC Rosters.docx",
      "province": "Marrowynd",
      "provinceKey": "marrowynd",
      "settlement": "Vaelshore",
      "settlementKey": "marrowynd:Vaelshore",
      "description": "Agent Xevran Gostamin is precise, intimidating, and emotionally sealed behind professional discipline, treating every assignment like a matter of containment rather than cruelty. As a Jazwed Dragonborn, xe carries lava-and-crystal lineage traits tied to fire, stone, elemental shaping, defensive engineering, and lawful enforcement, making xem terrifyingly suited to pursuit, extraction, and controlled violence.\nFrom the Directorate Retrieval Office, Xevran works as a hidden Glasswell Institute agent in Vaelshore, a Marrowynd town within an ocean province shaped by floating settlements and submarine access. Xe retrieves defectors, stolen research, escaped assets, fugitive witnesses, and compromised ledger-bearers with cold efficiency, but xem’s rigid loyalty can crack when a target proves more person than property.",
      "settlementAndAncestryTexture": "Vaelshore is a Town in Marrowynd, under Representative Democracy, with moderate danger, Beach and grass with water, Partial forest, Beach and reefs with water terrain. Local records favor Altruistic, Neutral, Cooperative, Honorable civic habits; common communities include Human, Halfling — Lightfoot Halfling, Elf — Wood Elf, Elf — Eladrin, Fey-Folk — Faerie. Jazwed Dragonborn reads through the Dragonborn entry of the race compendium, within Draconic and Reptilian Races, marked by Valkhamesh. Dragonborn are draconic humanoids born of ancient dragon lineage, elemental force, dynastic memory, and divine sovereignty. In Belavadös, a Dragonborn may carry traditional chromatic, metallic, or gem ancestry while a. Table cues: Dragon Ancestry, Breath Weapon, Damage Resistance, Darkvision; starting tendency Altruistic - Lawful - Cooperative - Honorable.",
      "rumors": [
        "Agent Xevran Gostamin knows why an ichor ledger changed hands last Nebday.",
        "Agent Xevran Gostamin has a contact in Morvélyn who will deny everything."
      ],
      "plotHooks": [
        "Agent Xevran Gostamin asks the party to protect a household member without revealing why.",
        "A rival faction offers proof that Agent Xevran Gostamin's public story is incomplete."
      ],
