  "npcs": [
    {
      "id": "hollis-combe",
      "name": "Hollis Combe",
      "sourceType": "immersive_npc_roster",
      "sourceFile": "NPC Rosters.docx",
      "province": "El'dravire Riverrealm",
      "provinceKey": "eldravireriverrealm",
      "settlement": "Caelthyrûn",
      "settlementKey": "eldravireriverrealm:Caelthyrûn",
      "description": "Hollis Combe is a tired, defensive Kithkin merchant who knows how to keep shelves stocked, ledgers balanced, and customers handled, but has grown small-hearted inside the safety of vault-and-bunker life. He was once warmer, more attentive, and genuinely helpful at the trade desk, but resentment, boredom, and a quiet dependence on diluted ichor have made him evasive, self-pitying, and prone to blaming the people closest to him for the life he helped build.\nAt the Caelthyrûn Guild Desk, Hollis sells household goods, vault supplies, repair kits, preserved food, and bunker necessities for the Regent Lattice, though his personal habits make him less reliable than his inventory. He is not cruel in a grand way, just disappointingly weak: the sort of man who still knows right from wrong, still occasionally does the decent thing, and still keeps choosing comfort, flirtation, and ichor-fogged avoidance over the family and community that need him awake.",
      "settlementAndAncestryTexture": "Caelthyrûn is a Town in El'dravire Riverrealm, under Parliamentary Government, with moderate danger, Beach and reefs with water, Beach and grass with water, Partial forest terrain. Local records favor Altruistic, Neutral, Cooperative, Honorable civic habits; common communities include Human, Halfling — Lightfoot Halfling, Elf — Wood Elf, Elf — Eladrin, Fey-Folk — Faerie. Kithkin reads through the Kithkin entry of the race compendium, within Halfling and Smallfolk, marked by Ishtanora. Kithkin are communal smallfolk with strong group identity and tradition-based societies. They prioritize cooperation, mutual protection, and moral simplicity. Table cues: Brave, Kithkin Nimbleness, Luck, Naturally Stealthy; starting tendency Altruistic - Lawful - Cooperative - Honorable.",
      "rumors": [
        "Hollis Combe knows why an ichor ledger changed hands last Marduday.",
        "Hollis Combe has a contact in Aelmoryth who will deny everything."
      ],
      "plotHooks": [
        "Hollis Combe asks the party to protect a household member without revealing why.",
        "A rival faction offers proof that Hollis Combe's public story is incomplete."
      ],
