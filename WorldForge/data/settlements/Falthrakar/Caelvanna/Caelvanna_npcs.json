  "npcs": [
    {
      "id": "dr-amara-mneme",
      "name": "Dr. Amara Mneme",
      "sourceType": "immersive_npc_roster",
      "sourceFile": "NPC Rosters.docx",
      "province": "Falthrakar",
      "provinceKey": "falthrakar",
      "settlement": "Caelvanna",
      "settlementKey": "falthrakar:Caelvanna",
      "description": "Dr. Amara Mneme is a Kenku memory surgeon who speaks softly, listens brutally, and knows that the mind can be both evidence and crime scene. At the Brass Concordat, she guides patients through memory dives, trauma echoes, stolen identities, and ichor-damaged recollections, using repeated phrases and mirrored voices to anchor people who might otherwise vanish inside themselves. Amara is compassionate but not sentimental; she will open a memory like a wound if truth is the only way to save the living.",
      "settlementAndAncestryTexture": "Caelvanna is a Town in Falthrakar, under Diarchy, with elevated danger, Partial forest, Deep forest, Marshes and swamps terrain. Local records favor Altruistic, Neutral, Cooperative, Honorable civic habits; common communities include Human, Halfling — Lightfoot Halfling, Elf — Wood Elf, Elf — Eladrin, Fey-Folk — Faerie. Kenku reads through the Kenku entry of the race compendium, within Birdfolk and Avian Races, marked by Sokhivar. Cursed avian mimics who cannot create original speech, Kenku communicate through imitation and stolen sounds. They are observant, clever, and highly adaptive despite limitations. Table cues: Expert Duplication, Kenku Recall, Mimicry; starting tendency Neutral - Chaotic - Neutral - Pragmatic.",
      "rumors": [
        "Amara can repeat a dead person's last words in their exact voice and hates that this comforts people.",
        "Her clinic keeps black curtains for patients whose memories react badly to moonlight."
      ],
      "plotHooks": [
        "Amara needs the party to guard a memory procedure while a hostile personality imprint tries to escape through the patient.",
        "A witness remembers a murder from the killer's perspective, and Amara thinks the memory was planted."
      ],
