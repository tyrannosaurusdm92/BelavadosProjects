  "npcs": [
    {
      "id": "bertha-smallreed",
      "name": "Bertha Smallreed",
      "sourceType": "immersive_npc_roster",
      "sourceFile": "NPC Rosters.docx",
      "province": "Eldermere",
      "provinceKey": "eldermere",
      "settlement": "Greenhollow Plains",
      "settlementKey": "eldermere:Greenhollow Plains",
      "description": "Bertha Smallreed is a young Halfling organizer with more courage than most adults around her and very little patience for being told to wait until things get worse. In Greenhollow Plains, she pushes the Choral Synod, local workers, and frightened families to repair defenses, share supplies, and stop pretending children do not notice political cowardice. She is charming, stubborn, and dangerous to complacent officials because she asks simple questions they cannot answer without admitting guilt.",
      "settlementAndAncestryTexture": "Greenhollow Plains is a Village in Eldermere, under Cooperative Commonwealth, with low danger, Farming, Partial forest, Deep forest terrain. Local records favor Altruistic, Lawful, Cooperative, Honorable civic habits; common communities include Human, Halfling — Lightfoot Halfling, Halfling — Stout Halfling, Kender, Kithkin. Halfling reads through the Halfling entry of the race compendium, within Halfling and Smallfolk, marked by Ishtanora. Halflings are small, cheerful folk known for luck, hospitality, and community bonds. They prefer peaceful living but are surprisingly resilient when threatened. Table cues: Brave, Halfling Nimbleness, Luck, Naturally Stealthy; starting tendency Altruistic - Lawful - Cooperative - Honorable.",
      "rumors": [
        "Bertha Smallreed knows why an ichor ledger changed hands last Marduday.",
        "Bertha Smallreed has a contact in Seralun who will deny everything."
      ],
      "plotHooks": [
        "Bertha Smallreed asks the party to protect a household member without revealing why.",
        "A rival faction offers proof that Bertha Smallreed's public story is incomplete."
      ],
