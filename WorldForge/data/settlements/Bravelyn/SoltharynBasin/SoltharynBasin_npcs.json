  "npcs": [
    {
      "id": "dr-andera-sootvein",
      "name": "Dr. Andera Sootvein",
      "sourceType": "immersive_npc_roster",
      "sourceFile": "NPC Rosters.docx",
      "province": "Bravelyn",
      "provinceKey": "bravelyn",
      "settlement": "Soltharyn Basin",
      "settlementKey": "bravelyn:Soltharyn Basin",
      "description": "Dr. Andera Sootvein is a blunt, road-tested Dwarf physician with steady hands, a soot-black sense of humor, and very little patience for patients who lie about what they drank, injected, inhaled, or bought from “a perfectly reputable cousin.” As a Marduthor-shaped Dwarf, they/she approaches medicine like craftwork: diagnose the crack, brace the structure, drain the poison, repair what can be repaired, and tell the fool exactly how close they came to dying.\nAt the Soltharyn Basin Tavern, Andera runs a back-room surgery center for wounds, curse-sickness, divine residue exposure, and ichor addiction, including withdrawal from diluted shop tonics, black-market battle ichor, and tavern-brewed “miracle” mixtures. The Brass Concordat values them because they can tell the difference between ordinary illness, bad liquor, contaminated ichor, and someone quietly being used as evidence in a larger crime.",
      "settlementAndAncestryTexture": "Soltharyn Basin is a Village in Bravelyn, under Gerontocracy, with moderate danger, Beach and reefs with water, Ocean Surface floating settlement, Beach and grass with water terrain. Local records favor Neutral, Lawful, Cooperative, Honorable civic habits; common communities include Human, Halfling — Lightfoot Halfling, Elf — Sea Elf, Tortle, Genasi — Water Genasi. Dwarf reads through the Dwarf entry of the race compendium, within Dwarven and Gnomish Kin, marked by Marduthor. Dwarves are stout, resilient folk deeply tied to stone, craft, and ancestral tradition. They value honor, craftsmanship, and enduring legacies over fleeting trends. Table cues: Darkvision, Dwarven Resilience, Dwarven Toughness, Stonecunning; starting tendency Neutral - Lawful - Cooperative - Honorable.",
      "rumors": [
        "Dr. Andera Sootvein knows why an ichor ledger changed hands last Valkhaday.",
        "Dr. Andera Sootvein has a contact in Vaelynor who will deny everything."
      ],
      "plotHooks": [
        "Dr. Andera Sootvein asks the party to protect a household member without revealing why.",
        "A rival faction offers proof that Dr. Andera Sootvein's public story is incomplete."
      ],
