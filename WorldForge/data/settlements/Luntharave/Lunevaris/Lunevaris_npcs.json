  "npcs": [
    {
      "id": "bobbin-nosenil",
      "name": "Bobbin Nosenil",
      "sourceType": "immersive_npc_roster",
      "sourceFile": "NPC Rosters.docx",
      "province": "Lun’tharavé",
      "provinceKey": "luntharave",
      "settlement": "Lunévaris",
      "settlementKey": "luntharave:Lunévaris",
      "description": "Bobbin Nosenil is a Gandirosha tunnel criminal with a quick grin, quicker lies, and a habit of selling impossible jobs as if they were errands. She survives through charm, luck, secret passages, and the confidence that everyone else is either greedy, bored, or easier to fool than she is. Bobbin is funny until the cave-in starts; then it becomes clear her plans always reserve the safest exit for herself.",
      "settlementAndAncestryTexture": "Lunévaris is a Village in Lun’tharavé, under Participatory Democracy, with low danger, Farming, Beach and grass with water, Mountain range terrain. Local records favor Altruistic, Lawful, Cooperative, Honorable civic habits; common communities include Human, Halfling — Lightfoot Halfling, Halfling — Stout Halfling, Kender, Kithkin. Gandirosha reads through the Fey-Folk entry of the race compendium, within Fey and Trickster Folk, marked by Thalunesh. Fey-Folk are peoples shaped by glamour, luck, tiny or otherworldly bodies, dreamlike emotion, and trickster magic. At my table, Faerie, Fairy, and Gandirosha are not separate top-level races here; they are bloodlines. Table cues: Fey Creature Type or Fey Ancestry, Fey Magic, Glamour or Luck Expression, Small/Tiny Fey Presence; starting tendency Neutral - Chaotic - Cooperative - Neutral.",
      "rumors": [
        "Bobbin knows more sealed tunnels than the city engineers and fewer of them are legal.",
        "She once sold the same hidden vault map to three crews and blamed the betrayal on bad ink."
      ],
      "plotHooks": [
        "Bobbin hires the party for a tunnel job, then the wall breaks into a sealed ichor storehouse instead of a treasury.",
        "A betrayed accomplice offers the party proof that Bobbin's latest dig could collapse a district above it."
      ],
