  "npcs": [
    {
      "id": "gloria-no-chain",
      "name": "Gloria No-Chain",
      "sourceType": "immersive_npc_roster",
      "sourceFile": "NPC Rosters.docx",
      "province": "Nalvessir",
      "provinceKey": "nalvessir",
      "settlement": "Palevanna",
      "settlementKey": "nalvessir:Palevanna",
      "description": "Gloria No-Chain is a fierce, blunt, combat-ready Feral Tiefling who was once treated like property and now makes it everyone’s problem when anyone else is treated the same. She is sarcastic, impatient with soft excuses, and terrifying in a fight, but her anger is rooted in loyalty: she believes escapees, constructs, Soulbounds, ichor-marked victims, and rewritten people all deserve freedom, not “proper handling.”\nAt the Palevanna Transit Yard, Gloria serves the Freeblade Veil as a safehouse heavy, clearing routes, escorting fugitives, and holding chokepoints when polite rescue becomes open battle. She especially hates missions that force her to destroy controlled or unfinished artificial beings, because to Gloria, even the roughest-made person deserves a chance to be more than the purpose someone built into them.",
      "settlementAndAncestryTexture": "Palevanna is a Town in Nalvessir, under Communalism, with low danger, Farming, Deep forest, Partial forest terrain. Local records favor Altruistic, Lawful, Cooperative, Honorable civic habits; common communities include Human, Halfling — Lightfoot Halfling, Halfling — Stout Halfling, Kender, Kithkin. Feral Tiefling reads through the Tiefling entry of the race compendium, within Celestial, Fiendish, and Planar Bloodlines, marked by Freyseth. Tieflings are fiend-touched humanoids marked by infernal ancestry and social stigma. They often develop strong individuality and resilience in the face of prejudice. Table cues: Darkvision, Fiendish Legacy, Otherworldly Presence; starting tendency Neutral - Chaotic - Neutral - Neutral.",
      "rumors": [
        "Gloria No-Chain knows why an ichor ledger changed hands last Valkhaday.",
        "Gloria No-Chain has a contact in Virethûn who will deny everything."
      ],
      "plotHooks": [
        "Gloria No-Chain asks the party to protect a household member without revealing why.",
        "A rival faction offers proof that Gloria No-Chain's public story is incomplete."
      ],
